# ═══ 7WONDERS ═══════════════════════════════════════════════════

# ─── Identidade ──────────────────────────────────────────────────
VITE_EVENT_NAME="7WONDERS"
VITE_EVENT_TZ="Europe/Lisbon"

# ─── 3cket (bilheteira) — SÓ NO SERVIDOR ─────────────────────────
# ⚠️ Estas duas NUNCA levam o prefixo VITE_.
# Tudo o que começa por VITE_ é embutido no site e fica visível a
# qualquer pessoa. Com a chave da 3cket é possível consultar e
# cancelar bilhetes de terceiros — por isso ela fica só aqui, no
# servidor, e é o servidor que fala com a 3cket.
#
# A chave é fornecida pela 3cket em separado, por evento.
THREECKET_SECRET_KEY=
THREECKET_API_URL=https://api.3cket.com

# Assina as sessões de quem já provou ter bilhete.
# Gerar com:  openssl rand -hex 32
# Obrigatória em produção.
SESSION_SECRET=

# ─── Supabase (inscrições e vagas) ───────────────────────────────
# Enquanto estiverem vazias, a plataforma corre em modo demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
